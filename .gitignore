# ==============================================================================
# Global & Environment Variables (Tuyệt đối không đẩy secrets lên git)
# ==============================================================================
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
frontend/.env.local

# Giữ lại các file mẫu cấu hình
!.env.example
!.env.*.example
!backend/.env.example
!frontend/.env.local.example

