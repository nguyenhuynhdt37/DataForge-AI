{
  "strict-quality-guard": {
    "enabled": true,
    "PreInvocation": [
      {
        "type": "command",
        "command": "./scripts/pre-invoke-reminder.sh",
        "timeout": 5
      }
    ],
    "PostToolUse": [
      {
        "matcher": "replace_file_content|write_to_file",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/post-tool-check.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
